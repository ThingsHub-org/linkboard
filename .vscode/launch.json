{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Linkboard (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Avvia Linkboard su rete",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:/*": "${webRoot}/*",
        "/./*": "${webRoot}/*",
        "/*": "${webRoot}/*"
      }
    }
  ]
}
